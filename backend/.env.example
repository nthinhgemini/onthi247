# Copy file này sang `.env` ở thù mục `backend/`

# Database - PostgreSQL (Docker local hoặc Cloud Supabase / Railway)
# Local Docker Compose:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/onthi2029?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/onthi2029?schema=public"

# App & Auth Config
PORT=3001
JWT_SECRET="dev-secret-change-me"
FRONTEND_URL="http://localhost:3000"

# OAuth Google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Gửi mail (Quên mật khẩu)
# MAILER_MOCK=true  -> Không gửi thật, lưu log trong app + trả dev_reset_token để dev/test
MAILER_MOCK="true"
MAILER_HOST="smtp.ethereal.email"
MAILER_PORT="587"
MAILER_USER=""
MAILER_PASS=""
MAILER_FROM="no-reply@onthi2029.vn"